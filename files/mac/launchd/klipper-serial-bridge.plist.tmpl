<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL_PREFIX@.klipper-serial-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>@BIN_DIR@/klipper-serial-bridge.py</string>
        <string>--port</string>
        <string>@SERIAL_PORT@</string>
        <string>--baud</string>
        <string>250000</string>
        <string>--listen</string>
        <string>@BRIDGE_LISTEN@</string>
        <string>--allow</string>
        <string>@VM_IP@</string>
    </array>
    <!-- keep macOS from throttling it like a background job: homing needs <25 ms round trips -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/klipper-serial-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/klipper-serial-bridge.log</string>
</dict>
</plist>
